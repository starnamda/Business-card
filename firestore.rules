rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/cards/{cardId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id','name','company','title','phone','email','memo','photo'])
        && request.resource.data.id == cardId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 500000;
    }
  }
}
